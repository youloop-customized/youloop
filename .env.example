# Copy this file to .env.local (which .gitignore already excludes) and fill in
# your own keys. Never commit real keys — see
# https://docs.stripe.com/keys-best-practices
# Get these from the Stripe Dashboard -> https://dashboard.stripe.com/test/apikeys

# Server-only. Must NOT be prefixed with NEXT_PUBLIC_, or Next.js would ship it
# to the browser.
STRIPE_SECRET_KEY=sk_test_...

# Get this from the Stripe Dashboard -> https://dashboard.stripe.com/workbench/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# The domain the success_url and cancel_url are built from.
DOMAIN=http://localhost:3000

# Not needed for hosted Checkout (the browser is redirected to Stripe rather
# than mounting Stripe.js). Only uncomment if you later move to embedded
# Checkout or Elements — browser-readable vars need the NEXT_PUBLIC_ prefix.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Already used by netlify/functions/submission-created.js; the Stripe webhook
# and /api/custom-order now share the same key.
RESEND_API_KEY=re_...

# MUST be a domain you have verified in Resend. The default sandbox sender
# (onboarding@resend.dev) can only deliver to your own Resend account address,
# so customer-facing email is skipped entirely until this is set.
RESEND_FROM=YOU LOOP <hello@youloop.co>

# Where the internal "new order" notices go.
NOTIFY_EMAIL=hello.youloop@gmail.com
